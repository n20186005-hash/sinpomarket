---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MARKET, withSiteName, type Faq } from '../../data/site';
import { breadcrumb, faqPage } from '../../lib/schema';

const site = Astro.site;
const crumbs = [
  { name: '홈', path: '/' },
  { name: '위치·교통', path: '/location/' },
];
const faqs: Faq[] = [
  ['신포국제시장은 어느 역에서 가까운가요?', '수인분당선 신포역이 가장 가깝습니다. 한국관광공사 시장 안내 기준으로 4번 출구에서 도보 약 3분으로 소개됩니다. 출구 공사나 보행 동선 변경이 있을 수 있어 당일 지도를 함께 확인하세요.'],
  ['수도권 1호선 인천역에서도 걸어갈 수 있나요?', '걸어서 접근할 수 있는 거리로 안내됩니다. 다만 원도심 일부 구간에 경사가 있어 짐이 많거나 더위·비가 있는 날에는 버스나 택시를 함께 고려하는 편이 편합니다.'],
  ['인천국제공항에서 바로 오려면 어떻게 하나요?', '공항철도로 계양역에서 인천1호선, 원인재역에서 수인분당선으로 갈아타 신포역에서 하차하는 철도 중심 경로가 일반적입니다. 짐이 많으면 택시와 소요 시간·비용을 비교하세요.'],
  ['버스 노선 번호를 알려주지 않는 이유가 있나요?', '시내버스는 노선 개편과 정류장 변경이 잦습니다. 특정 번호를 고정해 안내하면 실제 운행 정보와 어긋날 수 있어, 신포시장·신포동·동인천권 정류장을 검색해 당일 운행 노선을 확인하는 방식을 권합니다.'],
  ['주차는 어디에 하나요?', '시장 인근 유료 공영주차장을 이용할 수 있으며 장애인 전용 주차면도 안내되어 있습니다. 주말과 식사 시간대에는 만차 가능성이 높아 대중교통과 비교해 계획하세요.'],
  ['휠체어나 유모차로 접근할 수 있나요?', '주출입구 경사로와 휠체어 통과 가능한 출입구가 안내되어 있습니다. 다만 아케이드 내부는 시간대별 혼잡도가 크고 바닥 상태가 구간마다 다를 수 있어 한산한 시간대를 권합니다.'],
];
const routes = [
  { icon: '🚇', name: '지하철', text: '수인분당선 신포역 4번 출구에서 도보 약 3분(공식 관광안내 기준). 수도권 1호선 인천역에서도 도보 접근이 가능합니다.' },
  { icon: '✈️', name: '인천국제공항', text: '공항철도 → 계양역에서 인천1호선 → 원인재역에서 수인분당선으로 환승해 신포역에서 하차하는 철도 중심 경로가 있습니다.' },
  { icon: '🚌', name: '시내·공항버스', text: '신포시장·신포동·동인천권 정류장을 목적지로 검색해 현재 운행 중인 노선을 확인하세요. 노선 번호는 개편 가능성이 커 고정해 적지 않습니다.' },
  { icon: '🚕', name: '택시', text: '기사에게 “신포국제시장, 우현로49번길 11-5”를 제시하면 목적지 확인이 쉽습니다. 시장 안쪽은 보행 중심이므로 입구 부근에서 하차하세요.' },
  { icon: '🚗', name: '자가용', text: '원도심 도로가 좁고 주말 혼잡이 큽니다. 인근 유료 공영주차장 위치를 미리 확인하고, 만차 시 대중교통 전환을 염두에 두세요.' },
];
---
<BaseLayout
  title={withSiteName('위치·가는 법 · 지하철·주차')}
  description="신포국제시장 위치(인천광역시 제물포구 우현로49번길 11-5)와 가는 법을 안내합니다. 수인분당선 신포역 도보 약 3분, 인천역 도보 접근, 인천공항 철도 환승 경로, 버스·택시·주차 정보까지 정리했습니다."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb(site, crumbs))}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqPage(faqs))}></script>

  <section class="legal-hero"><div class="shell">
    <nav class="breadcrumb" aria-label="경로"><a href="/">홈</a><em aria-hidden="true">›</em><span>위치·교통</span></nav>
    <span class="kicker">위치·교통</span>
    <h1>신포국제시장 위치와<br/>가는 방법</h1>
    <p>지하철·공항 철도·버스·택시·자가용 경로를 계획용으로 정리했습니다. 노선 개편과 공사로 번호·시간표가 바뀔 수 있어 변동성이 큰 버스 번호는 고정해 적지 않았습니다.</p>
  </div></section>

  <section class="section"><div class="shell">
    <div class="visit-grid">
      <article class="info-card accent"><h3>주소</h3><p><strong>{MARKET.fullAddress}</strong><br/>2026년 행정체제 개편을 반영해 자치구를 제물포구로 표기합니다.</p></article>
      <article class="info-card"><h3>좌표</h3><p>북위 {MARKET.latitude}°, 동경 {MARKET.longitude}°. 지도 앱에 좌표를 입력하면 아케이드 입구를 찾기 쉽습니다.</p></article>
      <article class="info-card"><h3>대표 전화</h3><p>{MARKET.telephone}<br/>시장 운영 관련 문의는 점포별로 다를 수 있으며 공식 안내 채널을 함께 확인하세요.</p></article>
      <article class="info-card"><h3>가장 가까운 역</h3><p>수인분당선 신포역 4번 출구, 도보 약 3분(공식 관광안내 기준).</p></article>
      <article class="info-card"><h3>시장 입장</h3><p>입장료는 없습니다. 음식·상품 구매와 주차는 개별 결제입니다.</p></article>
      <article class="info-card"><h3>주차</h3><p>인근 유료 공영주차장 이용. 장애인 전용 주차면이 안내되어 있습니다.</p></article>
    </div>
  </div></section>

  <section class="section alt" id="map"><div class="shell">
    <div class="section-head"><div><span class="kicker">지도</span><h2>지도로<br/>먼저 확인하기</h2></div><p>지도 임베드는 한국어·대한민국 설정으로 불러옵니다. 지도에 표시되는 영업정보와 리뷰는 Google의 외부 데이터이며 본 사이트가 관리하지 않습니다.</p></div>
    <div class="map-wrap">
      <div class="map-copy"><span class="eyebrow">현지 언어 지도</span><h2>신포국제시장 위치</h2><p>출발 전 지도에서 <strong>우현로49번길 11-5</strong>를 검색하고, 당일 공사·행사로 인한 우회 동선이 있는지 함께 확인하세요.</p><div class="tag-row"><span class="tag">제물포구</span><span class="tag">신포역</span><span class="tag">개항장 원도심</span></div></div>
      <iframe class="map-frame" src={MARKET.mapEmbedUrl} width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="신포국제시장 Google 지도"></iframe>
    </div>
  </div></section>

  <section class="section dark"><div class="shell">
    <div class="section-head"><div><span class="kicker">교통 수단별</span><h2>어디서 출발하든<br/>신포역이 기준점</h2></div><p>가장 단순한 계획은 ‘수인분당선 신포역까지 오는 방법’을 먼저 정하는 것입니다. 역에 도착한 뒤에는 도보 3분 내외의 짧은 동선만 남습니다.</p></div>
    <div class="transport-layout">
      <div class="route-list">
        {routes.map((route) => (
          <article class="route"><div class="route-icon">{route.icon}</div><div><h3>{route.name}</h3><p>{route.text}</p></div></article>
        ))}
      </div>
      <aside class="transport-note"><h3>도보 마지막 구간 팁</h3><ol><li><strong>출구 번호를 먼저 확인</strong>하세요. 공사로 출입이 막힌 경우 인접 출구를 이용합니다.</li><li>원도심 구간에는 <strong>경사와 좁은 보도</strong>가 있어 캐리어 이동 시 시간이 더 걸릴 수 있습니다.</li><li>택시는 <strong>시장 입구 부근</strong>에서 하차한 뒤 걸어 들어가는 방식이 편합니다.</li><li>비가 오는 날에는 <strong>아케이드 연결 구간</strong>을 활용하면 동선이 짧아집니다.</li></ol><p>예상 소요 시간과 요금은 교통 상황·출발 지점에 따라 달라지므로 고정값으로 제시하지 않습니다.</p></aside>
    </div>
  </div></section>

  <section class="section"><div class="shell">
    <div class="section-head"><div><span class="kicker">주차와 접근</span><h2>차량 방문 시<br/>알아둘 점</h2></div><p>시장 자체 전용 주차시설 규모는 제한적입니다. 인근 공영주차장을 이용하는 계획이 일반적입니다.</p></div>
    <div class="visit-grid">
      <article class="info-card"><h3>공영주차장</h3><p>시장 인근 유료 공영주차장을 이용할 수 있습니다. 요금과 운영시간은 시설별로 다르므로 현장 표기를 확인하세요.</p></article>
      <article class="info-card"><h3>혼잡 시간</h3><p>주말과 식사 시간대에는 만차 가능성이 큽니다. 일찍 도착하거나 대중교통과 조합하는 방식을 고려하세요.</p></article>
      <article class="info-card"><h3>장애인 주차</h3><p>장애인 전용 주차면이 공식 무장애 관광자료에 안내되어 있습니다. 이용 기준은 현장 표기를 따릅니다.</p></article>
      <article class="info-card"><h3>전기차 충전</h3><p>시장 내부 전용 충전시설은 확인되지 않습니다. 인근 공공·민간 충전소를 지도 서비스에서 검색하세요.</p></article>
      <article class="info-card"><h3>무장애 동선</h3><p>주출입구 경사로와 휠체어 통과 가능한 출입구가 안내되어 있습니다. 아케이드 혼잡도는 시간대별로 차이가 큽니다.</p></article>
      <article class="info-card"><h3>귀가 동선</h3><p>저녁 시간대에는 택시 수요가 늘 수 있습니다. 막차 시간과 대체 노선을 미리 확인하세요.</p></article>
    </div>
  </div></section>

  <section class="section alt"><div class="shell">
    <div class="section-head"><div><span class="kicker">방문 전 확인</span><h2>길을 찾은 뒤에<br/>볼 정보</h2></div><p>위치를 확인했다면 운영시간과 먹거리 정보를 함께 살펴보세요.</p></div>
    <div class="cluster-grid">
      <a class="cluster-card" href="/hours/"><span class="tag">운영</span><h3>영업시간·휴무</h3><p>일반 안내 시간과 휴무 기준, 혼잡 시간대를 확인하세요.</p><span class="go">자세히 보기 →</span></a>
      <a class="cluster-card" href="/food/"><span class="tag">먹거리</span><h3>시장 먹거리</h3><p>닭강정·쫄면·만두·공갈빵 등 자주 만나는 음식 유형을 정리했습니다.</p><span class="go">자세히 보기 →</span></a>
      <a class="cluster-card" href="/nearby/"><span class="tag">연계</span><h3>주변 명소</h3><p>시장 방문 전후로 걸어서 연결하기 좋은 개항장 명소를 소개합니다.</p><span class="go">자세히 보기 →</span></a>
      <a class="cluster-card" href="/#transport"><span class="tag">요약</span><h3>교통 한눈에 보기</h3><p>첫 페이지의 상세 교통 요약으로 돌아가 전체 동선을 점검하세요.</p><span class="go">자세히 보기 →</span></a>
    </div>
  </div></section>

  <section class="section" id="faq"><div class="shell">
    <div class="section-head"><div><span class="kicker">자주 묻는 질문</span><h2>위치·교통<br/>질문 모음</h2></div><p>노선과 출입구는 공사·개편으로 바뀔 수 있습니다. 출발 당일 공식 교통정보와 지도를 함께 확인하세요.</p></div>
    <div class="faq-grid">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
  </div></section>
</BaseLayout>
